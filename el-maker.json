{
    "assignFeatures": {
        "roundabout": {
            "customData": {
                "raConfig": {
                    "weakRef": {
                        "properties": [
                            "hamburgerButton",
                            "closeButton",
                            "overlay",
                            "drawer"
                        ],
                        "listProperties": [
                            "inertTargetElements"
                        ],
                        "logIfCollected": "warn"
                    },
                    "assignOptions": {
                        "akaMethods": {
                            "🔍": "querySelector",
                            "😣": "focus",
                            "🧺": "querySelectorAll"
                        },
                        "substitutions": {
                            "inertTarget": "?.inertTarget"
                        }
                    },
                    "compacts": {
                        "on_click_of_hamburgerButton_assign": {
                            "open": true
                        },
                        "on_click_of_closeButton_assign": {
                            "open": false
                        },
                        "on_click_of_overlay_assign": {
                            "open": false
                        },
                        "on_keydown_of_ownerDocument_assignFromEvent": {
                            "?.escapeKeyPressed ?=": [
                                [
                                    "?.key",
                                    "Escape"
                                ],
                                true,
                                false
                            ]
                        }
                    },
                    "merges": [
                        {
                            "ifAllOf": [
                                "clone"
                            ],
                            "assign": {
                                "?.hamburgerButton": "?.clone?.querySelector?.[name=hamburger]",
                                "?.closeButton": "?.clone?.querySelector?.[name=close]",
                                "?.overlay": "?.clone?.querySelector?.[name=overlay]",
                                "?.drawer": "?.clone?.querySelector?.#drawer"
                            }
                        },
                        {
                            "ifAllOf": [
                                "drawer"
                            ],
                            "assign": {
                                "?.swipeDismiss?.handle": "?.drawer",
                                "?.swipeDismiss?.panel": "?.drawer",
                                "?.swipeDismiss?.direction ?=": [
                                    [
                                        "?.position",
                                        "right"
                                    ],
                                    1,
                                    -1
                                ]
                            }
                        },
                        {
                            "ifKeyIn": [
                                "open"
                            ],
                            "assign": {
                                "?.hamburgerButton?.ariaExpanded": "?.open",
                                "?.drawer?.ariaHidden ?=": [
                                    "?.open",
                                    false,
                                    true
                                ],
                                "?.overlay?.ariaHidden ?=": [
                                    "?.open",
                                    false,
                                    true
                                ],
                                "?.drawer?.inert ?=": [
                                    "?.open",
                                    false,
                                    true
                                ],
                                "?.escapeKeyPressed": false
                            }
                        },
                        {
                            "delay": 100,
                            "ifAllOf": [
                                "open"
                            ],
                            "assign": {
                                "?.querySelector?.a?.focus": {}
                            }
                        },
                        {
                            "ifKeyIn": [
                                "disabled"
                            ],
                            "ifAllOf": [
                                "clone"
                            ],
                            "assign": {
                                "?.hamburgerButton?.disabled": "?.disabled"
                            }
                        },
                        {
                            "ifAllOf": [
                                "escapeKeyPressed"
                            ],
                            "assign": {
                                "open": false
                            }
                        },
                        {
                            "ifAllOf": [
                                "clone",
                                "inertTarget",
                                "open"
                            ],
                            "assign": {
                                "inertTargetElements": "?.ownerDocument?.querySelectorAll?.inertTarget",
                                "?.inertTargetElements?.@each?.inert": true
                            }
                        },
                        {
                            "ifAllOf": [
                                "clone",
                                "inertTarget"
                            ],
                            "ifNoneOf": [
                                "open"
                            ],
                            "assign": {
                                "?.inertTargetElements?.@each?.inert": false
                            }
                        }
                    ],
                    "defaultPropVals": {
                        "open": false,
                        "disabled": false,
                        "position": "left"
                    }
                }
            },
            "withAttrs": {
                "disabled": "disabled",
                "open": "open",
                "_open": {
                    "instanceOf": "Boolean",
                    "mapsTo": "open"
                },
                "_disabled": {
                    "instanceOf": "Boolean",
                    "sourceOfTruth": true,
                    "mapsTo": "disabled"
                },
                "inertTarget": "inert-target",
                "_inertTarget": {
                    "mapsTo": "inertTarget"
                },
                "position": "position",
                "_position": {
                    "sourceOfTruth": true,
                    "valIfNull": "left",
                    "mapsTo": "position"
                }
            }
        },
        "templateMaker": {},
        "truthSourcer": {},
        "swipeDismiss": {
            "customData": {
                "assign": {
                    "onProgress": {
                        "?.drawer?.style?.transition": "none",
                        "?.drawer?.style?.clipPath =&": {
                            "join": [
                                "inset(0 ",
                                "?.progressState?.deltaPx",
                                "px 0 0)"
                            ]
                        }
                    },
                    "onCommit": {
                        "?.open": false,
                        "?.drawer?.style?.clipPath": "",
                        "?.drawer?.style?.transition": ""
                    },
                    "onCancel": {
                        "?.drawer?.style?.clipPath": "",
                        "?.drawer?.style?.transition": ""
                    }
                },
                "assignOptions": {
                    "withMethods": [
                        "querySelector"
                    ]
                }
            },
            "withAttrs": {
                "base": "swipe-dismiss",
                "axis": "${base}-axis",
                "direction": "${base}-direction",
                "distanceThreshold": "${base}-distance-threshold",
                "_distanceThreshold": {
                    "instanceOf": "Number",
                    "mapsTo": "distanceThreshold",
                    "valIfNull": 0.4
                },
                "velocityThreshold": "${base}-velocity-threshold",
                "_velocityThreshold": {
                    "instanceOf": "Number",
                    "mapsTo": "velocityThreshold",
                    "valIfNull": 0.5
                }
            }
        }
    }
}