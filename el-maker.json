{
    "assignFeatures": {
        "roundabout": {
            "customData": {
                "raConfig": {
                    "weakRef": {
                        "properties": [
                            "hamburgerButton",
                            "closeButton",
                            "overlay",
                            "drawer"
                        ],
                        "logIfCollected": "warn"
                    },
                    "assignOptions": {
                        "akaMethods": {
                            "🔍": "querySelector",
                            "😣": "focus"
                        }
                    },
                    "compacts": {
                        "on_click_of_hamburgerButton_assign": {
                            "open": true
                        },
                        "on_click_of_closeButton_assign": {
                            "open": false
                        },
                        "on_click_of_overlay_assign": {
                            "open": false
                        },
                        "on_keydown_of_ownerDocument_assignFromEvent": {
                            "?.escapeKeyPressed ?=": [
                                [
                                    "?.key",
                                    "Escape"
                                ],
                                true,
                                false
                            ]
                        }
                    },
                    "merges": [
                        {
                            "ifKeyIn": [
                                "clone"
                            ],
                            "assign": {
                                "?.hamburgerButton": "?.clone?.querySelector?.[name=hamburger]",
                                "?.closeButton": "?.clone?.querySelector?.[name=close]",
                                "?.overlay": "?.clone?.querySelector?.[name=overlay]",
                                "?.drawer": "?.clone?.querySelector?.[name=drawer]"
                            }
                        },
                        {
                            "ifKeyIn": [
                                "open"
                            ],
                            "assign": {
                                "?.hamburgerButton?.ariaExpanded": "?.open",
                                "?.drawer?.ariaHidden ?=": [
                                    "?.open",
                                    false,
                                    true
                                ],
                                "?.overlay?.ariaHidden ?=": [
                                    "?.open",
                                    false,
                                    true
                                ],
                                "?.drawer?.inert ?=": [
                                    "?.open",
                                    false,
                                    true
                                ],
                                "?.escapeKeyPressed": false
                            }
                        },
                        {
                            "delay": 100,
                            "ifAllOf": [
                                "open"
                            ],
                            "assign": {
                                "?.querySelector?.a?.focus": {}
                            }
                        },
                        {
                            "ifKeyIn": [
                                "disabled"
                            ],
                            "ifAllOf": [
                                "clone"
                            ],
                            "assign": {
                                "?.hamburgerButton?.disabled": "?.disabled"
                            }
                        },
                        {
                            "ifAllOf": [
                                "escapeKeyPressed"
                            ],
                            "assign": {
                                "open": false
                            }
                        }
                    ],
                    "defaultPropVals": {
                        "open": false,
                        "disabled": false
                    }
                }
            },
            "withAttrs": {
                "disabled": "disabled",
                "open": "open",
                "_open": {
                    "instanceOf": "Boolean",
                    "mapsTo": "open"
                },
                "_disabled": {
                    "instanceOf": "Boolean",
                    "sourceOfTruth": true,
                    "mapsTo": "disabled"
                }
            }
        },
        "templateMaker": {}
    }
}